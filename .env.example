# Copia este fichero a .env y rellena los valores.
# .env esta en .gitignore: nunca lo commitees.

# Supabase > Project Settings > API Keys
# La clave PUBLICABLE, la que empieza por sb_publishable_. Es la que va dentro
# de la app. Si algo te pide una clave larga que empieza por eyJ, esta escrito
# para el formato antiguo de claves.
#
# La clave SECRETA (sb_secret_...) NO va aqui ni en ningun sitio del repo.
# Solo vive en el panel de Supabase y dentro de las Edge Functions.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud > APIs & Services > Credentials
# Necesita habilitados "Maps SDK for Android" y "Maps SDK for iOS".
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
