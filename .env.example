# Copia este archivo a .env y rellena con los datos de tu proyecto de Supabase
# (Project Settings -> API en el dashboard de supabase.com).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Solo hace falta para Android (iOS usa Apple Maps sin key).
# Google Cloud Console -> credenciales -> API key con "Maps SDK for Android".
GOOGLE_MAPS_API_KEY=
